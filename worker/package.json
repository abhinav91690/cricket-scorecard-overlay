{
  "name": "cricket-scorecard-overlay-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker: first-party usage analytics collector and stats page for score.abhinav.dev",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply overlay-analytics --remote",
    "db:migrate:local": "wrangler d1 migrations apply overlay-analytics --local",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.129.0"
  }
}
