{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext"],
        "types": ["@cloudflare/workers-types"],
        "strict": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["src"]
}
