#!/bin/sh
# 🛑 Blocks a commit that would add a league member's real name to this public repo.
# See highlights/hooks/check_names.py for why, and why it fails OPEN.
# Install (once, repo-level, applies to every worktree):  git config core.hooksPath .githooks
# Bypass for one commit:  git commit --no-verify
root=$(git rev-parse --show-toplevel)
for py in "$root/highlights/.venv/bin/python" \
          "$(dirname "$root")/../highlights/.venv/bin/python" \
          python3; do
    [ -x "$py" ] || command -v "$py" >/dev/null 2>&1 || continue
    exec "$py" "$root/highlights/hooks/check_names.py"
done
echo "⚠ pre-commit: no python found; name check skipped."
exit 0
